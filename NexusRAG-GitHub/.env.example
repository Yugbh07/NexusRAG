# NexusRAG Environment Configuration Template
# Copy this file to .env and configure your values

# Application Runtime
PORT=8501
APP_NAME="NexusRAG"

# Google Gemini API
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Document Ingestion & Chunking
CHUNK_SIZE=600
CHUNK_OVERLAP=120
MAX_FILE_SIZE_MB=25

# Retrieval Configuration
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"
DEFAULT_TOP_K=3
ESCALATED_TOP_K=6
SIMILARITY_THRESHOLD_CONFIDENT=0.52
SIMILARITY_THRESHOLD_MINIMUM=0.28

# Cloud & Storage Settings
# Set to 'local' for development, or 'gcs' for Google Cloud Storage
STORAGE_BACKEND="local"
GCS_BUCKET_NAME=""
GCP_PROJECT_ID=""
GCP_REGION="asia-south1"
